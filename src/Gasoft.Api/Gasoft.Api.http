  "code": "GEN",
  "name": "General journal",
  "journalType": "General"
}

###

POST {{Gasoft.Api_HostAddress}}/api/v1/companies/{{companyId}}/journal-entries
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "journalId": 1,
  "accountingPeriodId": 1,
  "entryDate": "2026-01-15",
  "description": "Initial capital contribution",
  "lines": [
    {
      "accountId": 1,
      "transactionCurrencyCode": "USD",
      "debit": 1000,
      "credit": 0,
      "exchangeRate": 1,
      "description": "Cash received"
    },
    {
      "accountId": 2,
      "transactionCurrencyCode": "USD",
      "debit": 0,
      "credit": 1000,
      "exchangeRate": 1,
      "description": "Owner contribution"
    }
  ]
}

###

POST {{Gasoft.Api_HostAddress}}/api/v1/companies/{{companyId}}/journal-entries/1/post
Authorization: Bearer {{accessToken}}

###

