@Gasoft.Api_HostAddress = http://localhost:5035
@accessToken = replace-with-access-token-from-registration
@companyId = 1

GET {{Gasoft.Api_HostAddress}}/health
Accept: application/json

###

GET {{Gasoft.Api_HostAddress}}/api/v1/currencies
Accept: application/json

###

POST {{Gasoft.Api_HostAddress}}/api/v1/tenants/register
Content-Type: application/json

{
  "tenantName": "Northstar Studio",
  "slug": "northstar-studio",
  "companyCode": "NS01",
  "legalName": "Northstar Studio Ltd",
  "functionalCurrencyCode": "USD",
  "ownerDisplayName": "Jordan Davis",
  "email": "jordan@example.com",
  "password": "Choose-A-Strong-Password-123!"
}

###

POST {{Gasoft.Api_HostAddress}}/api/v1/auth/token
Content-Type: application/json

{
  "email": "jordan@example.com",
  "password": "Choose-A-Strong-Password-123!",
  "tenantId": 1
}

###

POST {{Gasoft.Api_HostAddress}}/api/v1/companies/{{companyId}}/account-groups
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "code": "CASH",
  "name": "Cash and cash equivalents",
  "accountType": "Asset"
}

###

POST {{Gasoft.Api_HostAddress}}/api/v1/companies/{{companyId}}/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "accountGroupId": 1,
  "code": "1000",
  "name": "Operating bank",
  "parentId": null,
  "allowPosting": true
}

###

GET {{Gasoft.Api_HostAddress}}/api/v1/companies/{{companyId}}/fiscal-years
Authorization: ******
Accept: application/json

###

GET {{Gasoft.Api_HostAddress}}/api/v1/companies/{{companyId}}/accounting-periods
Authorization: ******
Accept: application/json

###

GET {{Gasoft.Api_HostAddress}}/api/v1/companies/{{companyId}}/journals
Authorization: ******
Accept: application/json

###

